# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
# Changes to .env are picked up without restarting the app.

# --- SMTP server --------------------------------------------------------------
#   Gmail     smtp.gmail.com          465 (SSL) or 587 (STARTTLS)
#   Ukr.net   smtp.ukr.net            465 (SSL)
#   Outlook   smtp-mail.outlook.com   587 (STARTTLS)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
# auto = SSL on port 465, STARTTLS on any other port. Force with: ssl | starttls | none
SMTP_SECURITY=auto

# --- Sender -------------------------------------------------------------------
SENDER_EMAIL=you@gmail.com
# An APP PASSWORD, not your normal login password (see README.md).
SENDER_PASSWORD=

# --- Optional -----------------------------------------------------------------
# Display name in the From field, e.g. "Speachie Team"
SENDER_NAME=
# Where replies should go (default: SENDER_EMAIL)
REPLY_TO=
# Default address for Dry run test e-mails (default: SENDER_EMAIL)
DEBUG_EMAIL=
# Login name, only if it differs from SENDER_EMAIL
SMTP_USERNAME=
# Network timeout in seconds
SMTP_TIMEOUT=30
